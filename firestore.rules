// ASMS has migrated to Supabase (see the migration plan and this repo's
// supabase/ directory). This project now exists ONLY as a 48-hour
// read-only fallback in case a critical issue surfaces in the first
// days of real production usage on the new backend -- writes are
// blocked entirely so Firebase's data can never diverge from what's now
// the single source of truth in Supabase Postgres. Decommission this
// project once that window closes cleanly.
//
// This file must be manually published via Firebase Console → Firestore
// Database → Rules (or `firebase deploy --only firestore:rules` with the
// CLI) — editing it here does not change what's actually enforced live.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
