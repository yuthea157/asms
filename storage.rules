// ASMS has migrated to Supabase Storage (see the migration plan). This
// project now exists ONLY as a 48-hour read-only fallback -- writes are
// blocked entirely so nothing can diverge from the new source of truth.
// Decommission this project once that window closes cleanly.
//
// This file must be manually published via Firebase Console → Storage →
// Rules (or `firebase deploy --only storage` with the CLI) — editing it
// here does not change what's actually enforced live.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
